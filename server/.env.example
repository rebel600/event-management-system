# Railway injects PORT automatically — only set this locally.
PORT=3000

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<db>?retryWrites=true&w=majority

# Optional. The deployed app serves the client from this same origin, so CORS
# is not exercised in production. Set this only if the frontend is hosted on a
# separate domain. Comma-separated, no trailing slash.
# e.g. https://your-client.up.railway.app,http://localhost:5173
CLIENT_ORIGIN=
